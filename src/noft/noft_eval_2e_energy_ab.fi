!-----------------------------------------------------------------------
!>
!> \brief Calculate the 2-electron energy for opposite spin electrons
!>
!> For opposite spin electrons we don't need to worry about exchange
!> as those terms integrate to zero because the spin functions are
!> orthogonal.
!>
!> We do need to to consider the correlation terms.
!>
!> Note also that the electron repulsion operator is already transformed
!> into the molecular orbital basis.
!>
!> The Hartree-Fock like energy is then
!> \f{eqnarray}{
!> E_{hf} = \sum_{ik} (ii|kk)o_i o_k
!> \f}
!> where \f$i\f$ loops over \f$\alpha\$-orbitals and \f$k\f$ loops over
!> \f$\beta\f$-orbitals.
!>
!> The correlation contributions are given by
!> \f{eqnarray}{
!> E_{corr} = \sum_{ijkl} (ij|kl)w(o_i)w(o_j)w(o_k)w(o_l)
!>                        s(o_i,o_j,o_k,o_l)
!> \f}
!> where \f$w\f$ is a function of the occupation number that is 0 at
!> both 0 and 1 occupation, and \f$s\f$ is a function that determines
!> the sign of the contributions. Currently we choose \f$s\f$ to
!> correspond to the weak correlation limit. In that case
!> \f{eqnarray}{
!>  s = \left{\begin{array}{c}
!>      + \;\iff o_i, o_j, o_k, o_l \gt 1/2 \\
!>      + \;\iff o_i, o_j, o_k, o_l \le 1/2 \\
!>      - \;\text{otherwise}
!>      \end{array}\right.
!> \f}
!>
      subroutine noft_eval_2e_energy_ab(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
!DEBUG
!     write(*,*)
!DEBUG
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4.and.i1.eq.i3) then
                e_2e_ab = e_2e_ab
     &                  + ((occ_i_a(i1)*occ_i_b(i3)))
     &                  * moab(i1,i2,i3,i4)
              else if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                o1a = occ_i_a(i1)
                o2a = occ_j_a(i2)
                o1b = occ_i_b(i3)
                o2b = occ_j_b(i4)
                e_2e_ab_corr = e_2e_ab_corr
     &            + abs(moab(i1,i2,i3,i4))*
     &              noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)*
     &              noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)
!DEBUG
!     write(*,'("HVD: ",4i2,4f8.4,3f14.8)')i1,i2,i3,i4,o1a,o2a,o1b,o2b,
!    &      moab(i1,i2,i3,i4),
!    &      noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b),
!    &      noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)
!DEBUG
              endif
            enddo
          enddo
        enddo
      enddo
!DEBUG
!     write(*,*)
!DEBUG
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab
!
!-----------------------------------------------------------------------
!>
!> \brief Calculate the 2-electron energy for opposite spin electrons
!>        including the Löwdin-Shull terms
!>
!> For opposite spin electrons we don't need to worry about exchange
!> as those terms integrate to zero because the spin functions are
!> orthogonal.
!>
!> In this implementation we do incorporate the Löwdin-Shull terms that
!> stem from multi-determinantal wavefunction. These terms not clearly
!> separable from the regular Coulomb ones. Therefore they are lumped
!> in with the correlation free terms.
!>
      subroutine noft_eval_2e_energy_ab_ls(c_ls,c_ols,p_ls,p_ols,
     &           occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The Löwdin-Shull coefficient
      real(kind=dp), intent(in) :: c_ls
      !> The off-Löwdin-Shull coefficient
      real(kind=dp), intent(in) :: c_ols
      !> The Löwdin-Shull power
      real(kind=dp), intent(in) :: p_ls
      !> The off-Löwdin-Shull power
      real(kind=dp), intent(in) :: p_ols
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      real(kind=dp) :: e_2e_ab_ls
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_ls = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
!DEBUG
!     write(*,*)"*** HVD: noft_eval_2e_energy_ab_ls"
!DEBUG
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4.and.i1.eq.i3) then
                e_2e_ab_ls = e_2e_ab_ls
     &                     + c_ls*((occ_i_a(i1)*occ_i_b(i3))**p_ls)
     &                     * moab(i1,i2,i3,i4)
              else if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + c_ols*((occ_i_a(i1)*occ_i_b(i3))**p_ols)
     &                  * moab(i1,i2,i3,i4)
              endif
            enddo
          enddo
        enddo
      enddo
      e_2e_ab = e_2e_ab + e_2e_ab_ls
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_ls
!
!-----------------------------------------------------------------------
!>
!> \brief Calculate the 2-electron energy for opposite spin electrons
!>        including the Löwdin-Shull terms with schlenker functions
!>
!> For opposite spin electrons we don't need to worry about exchange
!> as those terms integrate to zero because the spin functions are
!> orthogonal.
!>
!> In this implementation we do incorporate the Löwdin-Shull terms that
!> stem from multi-determinantal wavefunction. These terms not clearly
!> separable from the regular Coulomb ones. Therefore they are lumped
!> in with the correlation free terms.
!>
!> In addition we implement the Löwdin-Shull terms using schlenker
!> functions that can be used to modify the shape of these terms.
!>
      subroutine noft_eval_2e_energy_ab_sls(s_ls,c_ls,c_ols,p_ls,p_ols,
     &           occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The schlenker function
      interface
        function s_ls(rho)
          import :: dp
          real(kind=dp), intent(in) :: rho
          real(kind=dp)             :: s_ls
        end function s_ls
      end interface
      !> The Löwdin-Shull coefficient
      real(kind=dp), intent(in) :: c_ls
      !> The off-Löwdin-Shull coefficient
      real(kind=dp), intent(in) :: c_ols
      !> The Löwdin-Shull power
      real(kind=dp), intent(in) :: p_ls
      !> The off-Löwdin-Shull power
      real(kind=dp), intent(in) :: p_ols
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      real(kind=dp) :: e_2e_ab_ls
      real(kind=dp) :: s_ls_i1, s_ls_i3
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_ls = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
!DEBUG
!     write(*,*)"*** HVD: noft_eval_2e_energy_ab_sls"
!DEBUG
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4.and.i1.eq.i3) then
                s_ls_i1 = s_ls(occ_i_a(i1))
                s_ls_i3 = s_ls(occ_i_b(i3))
                e_2e_ab_ls = e_2e_ab_ls
     &                     + c_ls*((s_ls_i1*s_ls_i3)**p_ls)
     &                     * moab(i1,i2,i3,i4)
              else if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + c_ols*((occ_i_a(i1)*occ_i_b(i3))**p_ols)
     &                  * moab(i1,i2,i3,i4)
              endif
            enddo
          enddo
        enddo
      enddo
      e_2e_ab = e_2e_ab + e_2e_ab_ls
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_sls
!
!-----------------------------------------------------------------------
!>
!> \brief Calculate the 2-electron energy for opposite spin electrons
!>        including the Löwdin-Shull terms and correlation
!>
!> For opposite spin electrons we don't need to worry about exchange
!> as those terms integrate to zero because the spin functions are
!> orthogonal.
!>
!> In this implementation we do incorporate the Löwdin-Shull terms that
!> stem from multi-determinantal wavefunction. These terms not clearly
!> separable from the regular Coulomb ones. Therefore they are lumped
!> in with the correlation free terms.
!>
!> In addition we calculate the correlation contributions. The results
!> in https://github.com/hjjvandam/2rdm-offdiag suggest that the
!> correlation occurs only between pairs of orbitals such that the sum
!> of their occupations is 1. Here we build that in.
!>
      subroutine noft_eval_2e_energy_ab_noft(ne_a,ne_b,
     &           c_ls,c_ols,c_noft,
     &           p_ls,p_ols,p_noft,p_enoft,
     &           occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The number of alpha electrons
      integer,       intent(in) :: ne_a
      !> The number of beta electrons
      integer,       intent(in) :: ne_b
      !> The Löwdin-Shull coefficient
      real(kind=dp), intent(in) :: c_ls
      !> The off-Löwdin-Shull coefficient
      real(kind=dp), intent(in) :: c_ols
      !> The NOFT term coefficient
      real(kind=dp), intent(in) :: c_noft
      !> The NOFT term power
      real(kind=dp), intent(in) :: p_noft
      !> The NOFT term exponent
      real(kind=dp), intent(in) :: p_enoft
      !> The Löwdin-Shull power
      real(kind=dp), intent(in) :: p_ls
      !> The off-Löwdin-Shull power
      real(kind=dp), intent(in) :: p_ols
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
!     real(kind=dp), allocatable :: corr(:,:)
!     real(kind=dp) :: result
!     integer :: i1r, i4r
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      real(kind=dp) :: e_2e_ab_ls
      real(kind=dp) :: fac
      real(kind=dp) :: fac_ls
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
!     p_enoft = -250.0_dp
!
      fac = 0.0_dp
      fac_ls = 0.0d0
      e_2e_ab = 0.0_dp
      e_2e_ab_ls = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
!test
!     allocate(corr(1:ihi(1),1:ihi(4)))
!     corr = 0.0_dp
!test
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4.and.i1.eq.i3) then
                fac_ls = fac_ls + c_ls*((occ_i_a(i1)*occ_i_b(i3))**p_ls)
                e_2e_ab_ls = e_2e_ab_ls
     &                     + c_ls*((occ_i_a(i1)*occ_i_b(i3))**p_ls)
     &                     * moab(i1,i2,i3,i4)
              else if (i1.eq.i2.and.i3.eq.i4) then
                fac = fac + c_ols*((occ_i_a(i1)*occ_i_b(i3))**p_ols)
                e_2e_ab = e_2e_ab
     &                  + c_ols*((occ_i_a(i1)*occ_i_b(i3))**p_ols)
     &                  * moab(i1,i2,i3,i4)
              else if (i1.eq.i3.and.i2.eq.i4) then
                if (((i1.le.ne_a).and.(i3.le.ne_b).and.
     &               (i2.gt.ne_a).and.(i4.gt.ne_b).and.
     &               (occ_i_a(i1).ge.0.5_dp).and.
     &               (occ_i_b(i3).ge.0.5_dp).and.
     &               (occ_j_a(i2).lt.0.5_dp).and.
     &               (occ_j_b(i4).lt.0.5_dp)).or.
     &              ((i1.gt.ne_a).and.(i3.gt.ne_b).and.
     &               (i2.le.ne_a).and.(i4.le.ne_b).and.
     &               (occ_i_a(i1).lt.0.5_dp).and.
     &               (occ_i_b(i3).lt.0.5_dp).and.
     &               (occ_j_a(i2).ge.0.5_dp).and.
     &               (occ_j_b(i4).ge.0.5_dp))) then
!test
!               corr(i1,i4) =
!    &              exp(p_enoft*(occ_i_a(i1)+occ_j_b(i4)-1.0_dp)**2)
!test
                e_2e_ab_corr = e_2e_ab_corr
     &              - 0.5_dp*c_noft
     &              * exp(p_enoft*(occ_i_a(i1)+occ_j_b(i4)-1.0_dp)**2)
     &              * ((16.0_dp*occ_i_a(i1)*(1.0_dp-occ_i_a(i1))*
     &                  occ_j_b(i4)*(1.0_dp-occ_j_b(i4)))**p_noft)
     &              * moab(i1,i2,i3,i4)
                endif
              endif
            enddo
          enddo
        enddo
      enddo
!test
!     do i1 = 1, ihi(1)
!       do i4 = 1, ihi(4)
!         write(10,'(2x,f12.6,$)')corr(i1,i4)
!       enddo
!       write(10,*)
!     enddo
!     close(10)
!     deallocate(corr)
!test
!DEBUG
!     write(*,*)"HVD1: ",ne_a*ne_b,fac_ls,fac
!DEBUG
      if (abs(fac).gt.1.0d-10) then
        fac = (ne_a * ne_b - fac_ls) / fac
      else
        fac = 0.0_dp
      endif
!DEBUG
!     write(*,*)"HVD2: ",ne_a*ne_b,fac_ls+fac,fac_ls,fac
!DEBUG
      e_2e_ab = e_2e_ab * fac + e_2e_ab_ls
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_noft
!
!-----------------------------------------------------------------------
!>
!> \brief Calculate the 2-electron energy for opposite spin electrons
!>        wthout correlation
!>
!> For opposite spin electrons we don't need to worry about exchange
!> as those terms integrate to zero because the spin functions are
!> orthogonal.
!>
!> In this subroutine we also do not consider electron correlation,
!> so all we have is the straightforward Coulomb term.
!>
      subroutine noft_eval_2e_energy_ab_nc(occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              endif
            enddo
          enddo
        enddo
      enddo
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_nc
!
!-----------------------------------------------------------------------
!
      subroutine noft_eval_2e_energy_ab_nel(ne_a,ne_b,c_ab,p_ab,
     &           occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The number of alpha electrons
      integer, intent(in) :: ne_a
      !> The number of beta electrons
      integer, intent(in) :: ne_b
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      real(kind=dp) :: fc
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
      integer :: ne_min, ne_max
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
!     do i1 = 1, ndim
!       ild(i1) = ihi(i1) - ilo(i1) + 1
!     enddo
      ild = 1
      ne_min = min(ne_a,ne_b)
      ne_max = max(ne_a,ne_b)
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
!DEBUG
!     write(*,*)
!DEBUG
      fc = 0.0_dp
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4.and.i1.eq.i3) then
                fc = fc + sqrt((occ_i_a(i1)*occ_i_b(i3)))
                e_2e_ab = e_2e_ab
     &                  + sqrt((occ_i_a(i1)*occ_i_b(i3)))
     &                  * moab(i1,i2,i3,i4)
              else if (i1.eq.i2.and.i3.eq.i4) then
                fc = fc + ((occ_i_a(i1)*occ_i_b(i3)))
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                if ((i1.le.ne_min.and.i2.gt.ne_max).or.
     &              (i1.gt.ne_max.and.i2.le.ne_min)) then
                  o1a = occ_i_a(i1)
                  o2a = occ_j_a(i2)
                  o1b = occ_i_b(i3)
                  o2b = occ_j_b(i4)
                  e_2e_ab_corr = e_2e_ab_corr
     &              - abs(moab(i1,i2,i3,i4))*
     &                noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)
!DEBUG
!     write(*,'("HVD: ",4i2,4f8.4,3f14.8)')i1,i2,i3,i4,o1a,o2a,o1b,o2b,
!    &      moab(i1,i2,i3,i4),
!    &      noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b),
!    &      noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)
!DEBUG
                endif
              endif
            enddo
          enddo
        enddo
      enddo
      fc = (ne_a * ne_b)/fc
!DEBUG
!     write(*,*)" fc,e_2e_ab,e_2e_corr = ",fc,e_2e_ab,e_2e_ab_corr
!DEBUG
!     e_2e_ab = e_2e_ab * fc
      e_2e_ab_corr = e_2e_ab_corr * fc
!DEBUG
!     write(*,*)
!DEBUG
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_nel
!
!-----------------------------------------------------------------------
!
!> \brief alpha-beta correlation energy based on an average of density
!>        matrices
!>
!> See "Further comments" in draft. Truly there is no uncorrelated part
!> in the subroutine. Nevertheless, in analogy to the other versions
!> we count the off-diagonal contributions as correlation and the
!> terms from the diagonal as the rest.
!>
      subroutine noft_eval_2e_energy_ab_avg(ne_a,ne_b,c_ab,p_ab,
     &           occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The number of alpha electrons
      integer, intent(in) :: ne_a
      !> The number of beta electrons
      integer, intent(in) :: ne_b
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ndims
      integer :: ityp
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
      integer :: ne_min, ne_max
      integer :: n_virt
      integer :: nmo
      real(kind=dp) :: fc, f, fi
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      f = 0.0_dp
!     do i1 = 1, ndim
!       ild(i1) = ihi(i1) - ilo(i1) + 1
!     enddo
      ild = 1
      ne_min = min(ne_a,ne_b)
      ne_max = max(ne_a,ne_b)
!
      call nga_inquire(moab_el_2,ityp,ndims,ihi)
      nmo = ihi(1)
      n_virt = nmo - ne_max
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
!DEBUG
!     write(*,*)
!DEBUG
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4.and.i1.eq.i3) then
                if (i1.le.ne_min) then
                  fi = real(ne_min-1,kind=dp)/real(ne_min,kind=dp)
     &               + sqrt(occ_i_a(i1)*occ_i_b(i3))/ne_min
                  f = f + fi
                  e_2e_ab = e_2e_ab + fi * moab(i1,i2,i3,i4)
                else if (i1.gt.ne_max) then
                  fi = real(ne_min-1,kind=dp)/real(ne_min,kind=dp)
     &               + sqrt(occ_i_a(i1)*occ_i_b(i3))/n_virt
                  f = f + fi
                  e_2e_ab = e_2e_ab + fi * moab(i1,i2,i3,i4)
                else
                  ! Singly occupied states cannot be doubly excited
                endif
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                if ((i1.le.ne_min.and.i2.gt.ne_max).or.
     &              (i1.gt.ne_max.and.i2.le.ne_min)) then
                  o1a = occ_i_a(i1)
                  o2a = occ_j_a(i2)
                  o1b = occ_i_b(i3)
                  o2b = occ_j_b(i4)
                  e_2e_ab_corr = e_2e_ab_corr
     &              - abs(moab(i1,i2,i3,i4))*
     &                noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)/
     &                (ne_min*n_virt)
!DEBUG
!     write(*,'("HVD: ",4i2,4f8.4,3f14.8)')i1,i2,i3,i4,o1a,o2a,o1b,o2b,
!    &      moab(i1,i2,i3,i4),
!    &      noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b),
!    &      noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)
!DEBUG
                endif
              endif
            enddo
          enddo
        enddo
      enddo
      fc = real(ne_a * ne_b,kind=dp)/f
      e_2e_ab = e_2e_ab * fc
      e_2e_ab_corr = e_2e_ab_corr * fc
!DEBUG
!     write(*,*)
!DEBUG
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_avg
!
!-----------------------------------------------------------------------
!
      subroutine noft_eval_2e_energy_ab_ws(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                o1a = occ_i_a(i1)
                o2a = occ_j_a(i2)
                o1b = occ_i_b(i3)
                o2b = occ_j_b(i4)
                e_2e_ab_corr = e_2e_ab_corr
     &            + abs(moab(i1,i2,i3,i4))*
     &              noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)*(
     &                noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b))
              endif
            enddo
          enddo
        enddo
      enddo
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_ws
!
!-----------------------------------------------------------------------
!
      subroutine noft_eval_2e_energy_ab_ws2(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                o1a = occ_i_a(i1)
                o2a = occ_j_a(i2)
                o1b = occ_i_b(i3)
                o2b = occ_j_b(i4)
                e_2e_ab_corr = e_2e_ab_corr
     &            + abs(moab(i1,i2,i3,i4))*
     &              noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)*(
     &                noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w3s(o1a,o2a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w3s(o1a,o2a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w3s(o1a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w3s(o2a,o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w2s2(o1a,o2a)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w2s2(o1a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w2s2(o2a,o1b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w2s2(o1a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w2s2(o2a,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w2s2(o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b))
              endif
            enddo
          enddo
        enddo
      enddo
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_ws2
!
!-----------------------------------------------------------------------
!
      subroutine noft_eval_2e_energy_ab_ws3(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                o1a = occ_i_a(i1)
                o2a = occ_j_a(i2)
                o1b = occ_i_b(i3)
                o2b = occ_j_b(i4)
                e_2e_ab_corr = e_2e_ab_corr
     &            + abs(moab(i1,i2,i3,i4))*
     &              noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)*(
     &                noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w3s(o1a,o2a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w3s(o1a,o2a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w3s(o1a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w3s(o2a,o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_2el_sign_w2s2(o1a,o2a)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_2el_sign_w2s2(o1a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_2el_sign_w2s2(o2a,o1b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -noft_2el_sign_w2s2(o1a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_2el_sign_w2s2(o2a,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_2el_sign_w2s2(o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b))
              endif
            enddo
          enddo
        enddo
      enddo
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_ws3
!
!-----------------------------------------------------------------------
!
      subroutine noft_eval_2e_energy_ab_ws4(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                o1a = occ_i_a(i1)
                o2a = occ_j_a(i2)
                o1b = occ_i_b(i3)
                o2b = occ_j_b(i4)
                e_2e_ab_corr = e_2e_ab_corr
     &            + abs(moab(i1,i2,i3,i4))*
     &              noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)*(
     &                noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +0*noft_2el_sign_w3s(o1a,o2a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +0*noft_2el_sign_w3s(o1a,o2a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +0*noft_2el_sign_w3s(o1a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +0*noft_2el_sign_w3s(o2a,o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_2el_sign_w2s2(o1a,o2a)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_2el_sign_w2s2(o1a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_2el_sign_w2s2(o2a,o1b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_2el_sign_w2s2(o1a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_2el_sign_w2s2(o2a,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_2el_sign_w2s2(o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b))
              endif
            enddo
          enddo
        enddo
      enddo
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_ws4
!
!-----------------------------------------------------------------------
!
      subroutine noft_eval_2e_energy_ab_ws5(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &           moab_el_2,e_2e_ab,e_2e_ab_corr)
      implicit none
      !> The opposite spin correlation coefficient
      real(kind=dp), intent(in) :: c_ab
      !> The opposite spin correlation power
      real(kind=dp), intent(in) :: p_ab
      !> The alpha orbital occupation numbers
      integer, intent(in) :: occ_1e_a
      !> The beta orbital occupation numbers
      integer, intent(in) :: occ_1e_b
      !> The alpha-beta 2-electron integrals in MO basis
      integer, intent(in) :: moab_el_2
      !> The opposite spin Coulomb energy
      real(kind=dp), intent(out) :: e_2e_ab
      !> The opposite spin correlation energy
      real(kind=dp), intent(out) :: e_2e_ab_corr
!
      real(kind=dp), allocatable :: occ_i_a(:)
      real(kind=dp), allocatable :: occ_j_a(:)
      real(kind=dp), allocatable :: occ_i_b(:)
      real(kind=dp), allocatable :: occ_j_b(:)
      real(kind=dp), pointer :: moab(:,:,:,:)
      real(kind=dp) :: o1a, o2a
      real(kind=dp) :: o1b, o2b
      integer, parameter :: ndim = 4
      integer :: ilo(ndim)
      integer :: ihi(ndim)
      integer :: ild(ndim)
      integer :: i1, i2, i3, i4
!
      e_2e_ab = 0.0_dp
      e_2e_ab_corr = 0.0_dp
      do i1 = 1, ndim
        ild(i1) = ihi(i1) - ilo(i1) + 1
      enddo
!
      call noft_access(moab_el_2,moab,ilo,ihi)
      allocate(occ_i_a(ilo(1):ihi(1)))
      allocate(occ_j_a(ilo(2):ihi(2)))
      allocate(occ_i_b(ilo(3):ihi(3)))
      allocate(occ_j_b(ilo(4):ihi(4)))
!
      call nga_get(occ_1e_a,ilo(1),ihi(1),occ_i_a,ild(1))
      call nga_get(occ_1e_a,ilo(2),ihi(2),occ_j_a,ild(2))
      call nga_get(occ_1e_b,ilo(3),ihi(3),occ_i_b,ild(3))
      call nga_get(occ_1e_b,ilo(4),ihi(4),occ_j_b,ild(4))
!
      do i4 = ilo(4), ihi(4)
        do i3 = ilo(3), ihi(3)
          do i2 = ilo(2), ihi(2)
            do i1 = ilo(1), ihi(1)
              if (i1.eq.i2.and.i3.eq.i4) then
                e_2e_ab = e_2e_ab
     &                  + occ_i_a(i1)*occ_i_b(i3)*moab(i1,i2,i3,i4)
              else if (i1.ne.i2.and.i3.ne.i4.and.
     &                 ((i1.eq.i3.and.i2.eq.i4).or.
     &                  (i1.eq.i4.and.i2.eq.i3))) then
                o1a = occ_i_a(i1)
                o2a = occ_j_a(i2)
                o1b = occ_i_b(i3)
                o2b = occ_j_b(i4)
                e_2e_ab_corr = e_2e_ab_corr
     &            + abs(moab(i1,i2,i3,i4))*
     &              noft_2el_weight_ab(c_ab,p_ab,o1a,o2a,o1b,o2b)*(
     &                noft_2el_sign_1el_occ(o1a,o2a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +0*noft_2el_sign_w3s(o1a,o2a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +0*noft_2el_sign_w3s(o1a,o2a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +0*noft_2el_sign_w3s(o1a,o1b,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               +0*noft_2el_sign_w3s(o2a,o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_2el_sign_w2s2(o1a,o2a)*
     &                noft_part_weak(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w2s2_2(o1a,o1b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w2s2_2(o2a,o1b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               +noft_2el_sign_w2s2_2(o1a,o2b)*
     &                noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w2s2_2(o2a,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               +noft_2el_sign_w2s2_2(o1b,o2b)*
     &                noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_weak(o2b)
     &               -0*noft_part_weak(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_weak(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_weak(o1b)*
     &                noft_part_strong(o2b)
     &               -0*noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_weak(o2b)
     &               -noft_part_strong(o1a)*
     &                noft_part_strong(o2a)*
     &                noft_part_strong(o1b)*
     &                noft_part_strong(o2b))
              endif
            enddo
          enddo
        enddo
      enddo
!
      deallocate(occ_j_b)
      deallocate(occ_i_b)
      deallocate(occ_j_a)
      deallocate(occ_i_a)
      call noft_release(moab_el_2,moab,ilo,ihi)
!
      end subroutine noft_eval_2e_energy_ab_ws5
!
!-----------------------------------------------------------------------
