!-----------------------------------------------------------------------
!>
!> \brief Evaluate the 2-electron energy contributions
!>
      subroutine noft_eval_2e_energy(noft_parameters,noft_operators,
     &                               noft_occupations,noft_energy)
      implicit none
#include "errquit.fh"
#include "noft_functional_options.fh"
      !> The calculation parameters
      type(noft_parameter_tp),   intent(in)    :: noft_parameters
      !> The operators
      type(noft_operators_tp),   intent(in)    :: noft_operators
      !> The occupation numbers
      type(noft_occupations_tp), intent(in)    :: noft_occupations
      !> The energy contributions
      type(noft_energy_tp),      intent(inout) :: noft_energy
!
!     Local
!
      real(kind=dp) :: en_2el
      real(kind=dp) :: en_2el_corr
      real(kind=dp) :: c_aa, c_ab, c_ls, c_ols, c_noft
      real(kind=dp) :: p_aa, p_ab, p_ls, p_ols, p_noft, p_enoft
      integer :: moaa_el_2, moab_el_2, mobb_el_2
      integer :: occ_1e_a,  occ_1e_b
      integer :: occ_2e_aa, occ_2e_bb
      integer :: functional
      integer :: ne_a, ne_b
      integer :: s_ls
      character(len=21), parameter :: pname =
     &  "noft_eval_2e_energy: "
      character(len=4) :: func
      character(len=12) :: str_s_ls
!
      c_aa    = noft_parameters%c_aa
      c_ab    = noft_parameters%c_ab
      c_ls    = noft_parameters%c_ls
      c_ols   = noft_parameters%c_ols
      c_noft  = noft_parameters%c_noft
      p_aa    = noft_parameters%p_aa
      p_ab    = noft_parameters%p_ab
      p_ls    = noft_parameters%p_ls
      p_ols   = noft_parameters%p_ols
      p_noft  = noft_parameters%p_noft
      p_enoft = noft_parameters%p_enoft
      s_ls    = noft_parameters%s_ls
      ne_a    = noft_parameters%ne_a
      ne_b    = noft_parameters%ne_b
      functional = noft_parameters%functional
!
      moaa_el_2 = noft_operators%moaa_el_2
      moab_el_2 = noft_operators%moab_el_2
      mobb_el_2 = noft_operators%mobb_el_2
!
      occ_1e_a  = noft_occupations%occ_1e_a
      occ_1e_b  = noft_occupations%occ_1e_b
      occ_2e_aa = noft_occupations%occ_2e_aa
      occ_2e_bb = noft_occupations%occ_2e_bb
!
      noft_energy%e_2electron = 0.0_dp
      noft_energy%e_correlation_aa = 0.0_dp
      noft_energy%e_correlation_ab = 0.0_dp
      noft_energy%e_correlation_bb = 0.0_dp
!
      if (functional.eq.weakstrong) then
!
!       the combined weak-strong correlation model
!
        call noft_eval_2e_energy_ab_ws(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &                                 moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.weakstrong_ii) then
!
!       the combined weak-strong correlation model II
!
        call noft_eval_2e_energy_ab_ws2(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &                                  moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.weakstrong_iii) then
!
!       the combined weak-strong correlation model III
!
        call noft_eval_2e_energy_ab_ws3(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &                                  moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.weakstrong_iv) then
!
!       the combined weak-strong correlation model IV
!
        call noft_eval_2e_energy_ab_ws4(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &                                  moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.weakstrong_v) then
!
!       the combined weak-strong correlation model V
!
        call noft_eval_2e_energy_ab_ws5(c_ab,p_ab,occ_1e_a,occ_1e_b,
     &                                  moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.average) then
        call noft_eval_2e_energy_ab_avg(ne_a,ne_b,c_ab,p_ab,
     &                                  occ_1e_a,occ_1e_b,
     &                                  moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.nocorrelation) then
        call noft_eval_2e_energy_ab_nc(occ_1e_a,occ_1e_b,
     &                                 moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.ddft.or.
     &         functional.eq.ddft_ii) then
        if (s_ls.eq.s0_ls) then
          call noft_eval_2e_energy_ab_ls(c_ls,c_ols,p_ls,p_ols,
     &                                   occ_1e_a,occ_1e_b,
     &                                   moab_el_2,en_2el,en_2el_corr)
        else if (s_ls.eq.s1_ls) then
          call noft_eval_2e_energy_ab_sls(noft_schlenker_1,
     &                                    c_ls,c_ols,p_ls,p_ols,
     &                                    occ_1e_a,occ_1e_b,
     &                                    moab_el_2,en_2el,en_2el_corr)
        else if (s_ls.eq.s2_ls) then
          call noft_eval_2e_energy_ab_sls(noft_schlenker_2,
     &                                    c_ls,c_ols,p_ls,p_ols,
     &                                    occ_1e_a,occ_1e_b,
     &                                    moab_el_2,en_2el,en_2el_corr)
        else if (s_ls.eq.s3_ls) then
          call noft_eval_2e_energy_ab_sls(noft_schlenker_3,
     &                                    c_ls,c_ols,p_ls,p_ols,
     &                                    occ_1e_a,occ_1e_b,
     &                                    moab_el_2,en_2el,en_2el_corr)
        else if (s_ls.eq.s2s3_ls) then
          call noft_eval_2e_energy_ab_sls(noft_schlenker_23,
     &                                    c_ls,c_ols,p_ls,p_ols,
     &                                    occ_1e_a,occ_1e_b,
     &                                    moab_el_2,en_2el,en_2el_corr)
        else if (s_ls.eq.s3s2_ls) then
          call noft_eval_2e_energy_ab_sls(noft_schlenker_32,
     &                                    c_ls,c_ols,p_ls,p_ols,
     &                                    occ_1e_a,occ_1e_b,
     &                                    moab_el_2,en_2el,en_2el_corr)
        else
          write(str_s_ls,*)s_ls
          call errquit(pname//" unknown schlenker: "//str_s_ls, 5,
     &                 UERR)
        endif
      else if (functional.eq.dft) then
        call noft_eval_2e_energy_ab_nc(occ_1e_a,occ_1e_b,
     &                                 moab_el_2,en_2el,en_2el_corr)
      else if (functional.eq.noftf) then
        call noft_eval_2e_energy_ab_noft(ne_a,ne_b,c_ls,c_ols,c_noft,
     &                                   p_ls,p_ols,p_noft,p_enoft,
     &                                   occ_1e_a,occ_1e_b,
     &                                   moab_el_2,en_2el,en_2el_corr)
      else
!
!       the weak correlation model
!
!       call noft_eval_2e_energy_ab(c_ab,p_ab,occ_1e_a,occ_1e_b,
!    &                              moab_el_2,en_2el,en_2el_corr)
        call noft_eval_2e_energy_ab_nel(ne_a,ne_b,c_ab,p_ab,
     &                                  occ_1e_a,occ_1e_b,
     &                                  moab_el_2,en_2el,en_2el_corr)
      endif
      noft_energy%e_2electron = noft_energy%e_2electron + en_2el
      noft_energy%e_correlation_ab = en_2el_corr
!
      if (functional.eq.ddft.or.
     &    functional.eq.ddft_ii.or.
     &    functional.eq.dft.or.
     &    functional.eq.noftf.or.
     &    functional.eq.nocorrelation) then
        call noft_eval_2e_energy_aa_nc(occ_2e_aa,
     &                                 moaa_el_2,en_2el,en_2el_corr)
      else if (functional.eq.same) then
        call noft_eval_2e_energy_aa_1(c_aa,p_aa,occ_1e_a,occ_2e_aa,
     &                                moaa_el_2,en_2el,en_2el_corr)
      else if (functional.eq.conjugate.or.
     &         functional.eq.weakstrong.or.
     &         functional.eq.weakstrong_ii.or.
     &         functional.eq.weakstrong_iii.or.
     &         functional.eq.weakstrong_iv.or.
     &         functional.eq.weakstrong_v.or.
     &         functional.eq.average) then
        call noft_eval_2e_energy_aa_2(c_aa,p_aa,occ_1e_a,occ_2e_aa,
     &                                moaa_el_2,en_2el,en_2el_corr)
      else if (functional.eq.both) then
        call noft_eval_2e_energy_aa_3(c_aa,p_aa,occ_1e_a,occ_2e_aa,
     &                                moaa_el_2,en_2el,en_2el_corr)
      else
        write(func,'(i2)')functional
        call errquit(pname//" unknown functional: "//func, 10,
     &               UERR)
      endif
      noft_energy%e_2electron = noft_energy%e_2electron + en_2el
      noft_energy%e_correlation_aa = en_2el_corr
!
      if (functional.eq.ddft.or.
     &    functional.eq.ddft_ii.or.
     &    functional.eq.dft.or.
     &    functional.eq.noftf.or.
     &    functional.eq.nocorrelation) then
        call noft_eval_2e_energy_aa_nc(occ_2e_bb,
     &                                 mobb_el_2,en_2el,en_2el_corr)
      else if (functional.eq.same) then
        call noft_eval_2e_energy_aa_1(c_aa,p_aa,occ_1e_b,occ_2e_bb,
     &                                mobb_el_2,en_2el,en_2el_corr)
      else if (functional.eq.conjugate.or.
     &         functional.eq.weakstrong.or.
     &         functional.eq.weakstrong_ii.or.
     &         functional.eq.weakstrong_iii.or.
     &         functional.eq.weakstrong_iv.or.
     &         functional.eq.weakstrong_v.or.
     &         functional.eq.average) then
        call noft_eval_2e_energy_aa_2(c_aa,p_aa,occ_1e_b,occ_2e_bb,
     &                                mobb_el_2,en_2el,en_2el_corr)
      else if (functional.eq.both) then
        call noft_eval_2e_energy_aa_3(c_aa,p_aa,occ_1e_b,occ_2e_bb,
     &                                mobb_el_2,en_2el,en_2el_corr)
      else
        write(func,'(i2)')functional
        call errquit(pname//" unknown functional: "//func, 20,
     &               UERR)
      endif
      noft_energy%e_2electron = noft_energy%e_2electron + en_2el
      noft_energy%e_correlation_bb = en_2el_corr
!
      end subroutine noft_eval_2e_energy
!
!-----------------------------------------------------------------------
