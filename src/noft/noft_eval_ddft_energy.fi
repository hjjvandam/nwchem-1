!-----------------------------------------------------------------------
!>
!> \brief Evaluate the delta density functional energy
!>
!> Considering that in post-Hartree-Fock methods electron correlation
!> corresponds one-to-one with orbital occupations deviating from
!> integer values we attempt a new way to think about DFT.
!>
!> With the TFD energy expression we have an N-representable
!> uncorrelated energy even when we have fractional occupation numbers.
!> In principle it should be possible to write the correlation energy
!> as a functional of the change in electron density due to correlation.
!> The fundamental challenge is that DFT is over 60 years old, and the
!> Kohn-Sham method is actually 60 years as I am writing this (2025).
!> In all those years the total energy has been approached as a
!> functional of the electron density. There are no functionals, as
!> far as I am aware, that consider just the correlation energy as a
!> functional of just the change in electron density. To avoid having
!> to develop an entirely new class of functionals from scratch, let's
!> approach this problem from the perspective of existing functionals.
!>
!> In conventional quantum chemistry a single Slater determinant
!> corresponds to a system without correlation. It also produces an
!> idem-potent 1-electron density matrix for both spins. DFT takes
!> the electron density from this and estimates the total energy.
!>
!> Electron correlation corresponds to multi-determinantal wavefunctions
!> that produce density matrices with fractional occupation numbers.
!> We can use DFT to estimate the total energy from the density of this
!> system as well.
!>
!> The difference between the densities of these two systems is clearly
!> due to the presence of electron correlation. Likewise the difference
!> between the DFT energies is associated with the correlation energy
!> due to the change in density.
!>
!> If we call the electron density from the idem-potent density matrix
!> Dip, and the density from the correlated density matrix Dc, and
!> density functional F, then we can approximate the correlation energy
!> as F(Dc)-F(Dip). Subsequently we add this correlation energy to an
!> effective 1-electron model that is also N-representable with
!> non-integer occupation numbers, for example the TFD electron energy.
!>
!> This subroutine evaluates this difference density functional
!> to obtain the correlation energy.
!>
      subroutine noft_eval_ddft_energy(rtdb,noft_parameters,
     &           noft_occupations,noft_wavefunction,noft_energy)
      implicit none
#include "global.fh"
#include "mafdecls.fh"
#include "noft_functional_options.fh"
#include "stdio.fh"
      !> The handle for the runtime database
      integer,                    intent(in)    :: rtdb
      !> The parameters for the calculation
      type(noft_parameter_tp),    intent(in)    :: noft_parameters
      !> The wavefunction
      type(noft_wavefunction_tp), intent(in)    :: noft_wavefunction
      !> The occupation numbers
      type(noft_occupations_tp),  intent(in)    :: noft_occupations
      !> The energy terms and total
      type(noft_energy_tp),       intent(inout) :: noft_energy
!
!     Local
!
      type(noft_occupations_tp) :: dip_occupations
      type(noft_occupations_tp) :: diff_occupations
      integer                   :: g_dens(2)
      integer                   :: g_vxc(4)
      integer, parameter        :: ndim = 2
      integer                   :: dims(ndim)
      integer                   :: chunk(ndim)
      real(kind=dp)             :: exc
      real(kind=dp)             :: rho_n
      real(kind=dp)             :: dume
      real(kind=dp)             :: dum1
      real(kind=dp)             :: dum2
      real(kind=dp)             :: dum3
      real(kind=dp)             :: EFc
      real(kind=dp)             :: EFip
      real(kind=dp)             :: EFdiff
!
      logical, external         :: xc_gotxc
!
      noft_energy%e_correlation_ddft = 0.0_dp
      noft_energy%e_correlation_dft = 0.0_dp
      if (noft_parameters%functional.ne.ddft.and.
     &    noft_parameters%functional.ne.ddft_ii.and.
     &    noft_parameters%functional.ne.dft) then
        !
        ! This is not a DDFT nor a DFT calculation
        !
        return
      else
        if (.not.xc_gotxc()) then
          !
          ! No density functional has been specified (weird though)
          !
          return
        endif
      endif
!
      call noft_occupations_create(noft_parameters,dip_occupations)
      call noft_occupations_create(noft_parameters,diff_occupations)
      call ddft_occupations_calculate(noft_parameters,noft_occupations,
     &                                dip_occupations)
      if (noft_parameters%functional.eq.ddft) then
        call diff_occupations_calculate(noft_parameters,
     &       noft_occupations,dip_occupations,diff_occupations)
      else if (noft_parameters%functional.eq.ddft_ii) then
        call diff_occupations_calculate_ii(noft_parameters,
     &       noft_occupations,dip_occupations,diff_occupations)
      endif
      chunk = -1
      dims  = noft_parameters%nao
!DEBUG
!     write(6,*)"HVD*in************************************************"
!DEBUG
      g_vxc = 0
      if (.not.nga_create(MT_DBL,ndim,dims,"dens_a",chunk,g_dens(1)))
     &  call ga_error("Could not create dens_a")
      if (.not.nga_create(MT_DBL,ndim,dims,"dens_b",chunk,g_dens(2)))
     &  call ga_error("Could not create dens_b")
      if (.not.nga_create(MT_DBL,ndim,dims,"vxc_a",chunk,g_vxc(1)))
     &  call ga_error("Could not create vxc_a")
      if (.not.nga_create(MT_DBL,ndim,dims,"vxc_b",chunk,g_vxc(2)))
     &  call ga_error("Could not create vxc_b")
!
!     call noft_eval_density_matrix_ao(noft_parameters,
!    &     noft_occupations,noft_wavefunction,g_dens)
      if (noft_parameters%functional.eq.dft) then
        call noft_eval_density_matrix_ao(noft_parameters,
     &       noft_occupations,noft_wavefunction,g_dens)
      else if (noft_parameters%functional.eq.ddft.or.
     &         noft_parameters%functional.eq.ddft_ii) then
        call noft_eval_density_matrix_ao(noft_parameters,
     &       diff_occupations,noft_wavefunction,g_dens)
      endif
      call ga_zero(g_vxc(1))
      call ga_zero(g_vxc(2))
      call xc_getv(rtdb,exc,dume,1,0,0,g_dens,g_vxc,
     &     .false.,0,0,0,.false.,rho_n,dum1,dum2,0,dum3)
!     if (ga_nodeid().eq.0.and.abs(rho_n).gt.1.0d-3)
!    &    write(luout,*)"Integrate difference density: ",rho_n
      EFc = ga_ddot(g_dens(1),g_vxc(1)) + ga_ddot(g_dens(2),g_vxc(2))
!
!     call noft_eval_density_matrix_ao(noft_parameters,
!    &     dip_occupations,noft_wavefunction,g_dens)
!     call ga_zero(g_vxc(1))
!     call ga_zero(g_vxc(2))
!     call xc_getv(rtdb,exc,dume,1,0,0,g_dens,g_vxc,
!    &     .false.,0,0,0,.false.,rho_n,dum1,dum2,0,dum3)
!     if (ga_nodeid().eq.0.and.abs(rho_n).gt.1.0d-3)
!    &    write(luout,*)"Integrate difference density: ",rho_n
!     EFip = ga_ddot(g_dens(1),g_vxc(1)) + ga_ddot(g_dens(2),g_vxc(2))
!


!     call noft_eval_density_matrix_ao(noft_parameters,
!    &     diff_occupations,noft_wavefunction,g_dens)
!     EFdiff = ga_ddot(g_dens(1),g_vxc(1)) + ga_ddot(g_dens(2),g_vxc(2))
!     EFdiff = EFdiff*noft_parameters%c_ddft
!
!DEBUG
!     write(luout,*)"OCCip"
!     call ga_print(dip_occupations%occ_1e_a)
!     write(luout,*)"OCCc"
!     call ga_print(noft_occupations%occ_1e_a)
!     write(luout,*)"EFc    = ",EFc
!     write(6,*)"HVD*out***********************************************"
!DEBUG
!     noft_energy%e_correlation_ddft = (EFc - EFip)
!     noft_energy%e_correlation_ddft = EFc
!     noft_energy%e_correlation_ddft = - 1000.0_dp*(EFc - EFip)
      if (noft_parameters%functional.eq.ddft.or.
     &    noft_parameters%functional.eq.ddft_ii) then
        noft_energy%e_correlation_ddft = EFc*noft_parameters%c_ddft
        noft_energy%e_correlation_dft = 0.0_dp
      else if (noft_parameters%functional.eq.dft) then
        noft_energy%e_correlation_ddft = 0.0_dp
        noft_energy%e_correlation_dft = EFc*noft_parameters%c_dft
      endif
!
      if (.not.ga_destroy(g_vxc(2)))
     &  call ga_error("Could not destroy vxc_b")
      if (.not.ga_destroy(g_vxc(1)))
     &  call ga_error("Could not destroy vxc_a")
      if (.not.ga_destroy(g_dens(2)))
     &  call ga_error("Could not destroy dens_b")
      if (.not.ga_destroy(g_dens(1)))
     &  call ga_error("Could not destroy dens_a")
      call noft_occupations_destroy(diff_occupations)
      call noft_occupations_destroy(dip_occupations)
      end subroutine noft_eval_ddft_energy
!
!-----------------------------------------------------------------------
