!-----------------------------------------------------------------------
!>
!> \brief Calculate the DDFT occupation numbers
!>
!> In DDFT we calculate the correlation energy as a functional of the
!> redistribution of the electrons density due to electron correlation.
!> We assume an idem-potent density matrix as the uncorrelated
!> reference state. Here we calculate the integer occupation numbers of
!> reference state.
!>
!> 1. Sort the occupation numbers in decreasing order (value and index)
!> 2. For the Ne highest occupied orbitals set the occupation number
!>    to one.
!> 3. Keep all other occupation numbers at zero.
!>
      subroutine ddft_occupations_calculate(noft_parameters,
     &           noft_occupations,ddft_occupations)
      implicit none
      !> The parameters for the calculation
      type(noft_parameter_tp),    intent(in)    :: noft_parameters
      !> The actual occupation numbers
      type(noft_occupations_tp),  intent(in)    :: noft_occupations
      !> The difference density occupation numbers
      type(noft_occupations_tp),  intent(inout) :: ddft_occupations
      !
      ! Local
      !
      integer :: norb
      integer :: nel
      integer :: occ_1e_a, occ_1e_b
      integer :: ii, jj
      real(kind=dp)              :: one
      real(kind=dp), allocatable :: noft_occ(:)
      real(kind=dp), allocatable :: ddft_occ(:)
      integer,       allocatable :: ddft_ind(:)
      !
      one  = 1.0_dp
      norb = noft_parameters%nmo
      allocate(noft_occ(1:norb))
      allocate(ddft_occ(1:norb))
      allocate(ddft_ind(1:norb))
      !
      nel = noft_parameters%ne_a
      occ_1e_a = noft_occupations%occ_1e_a
      call ga_get(occ_1e_a,1,norb,1,1,noft_occ,1)
      call ddft_sort_occ(norb,noft_occ,ddft_occ,ddft_ind)
      occ_1e_a = ddft_occupations%occ_1e_a
      call ga_zero(occ_1e_a)
      do ii = 1, nel
        jj = ddft_ind(ii)
        call ga_put(occ_1e_a,jj,jj,1,1,one,1)
      enddo
      !
      nel = noft_parameters%ne_b
      occ_1e_b = noft_occupations%occ_1e_b
      call ga_get(occ_1e_b,1,norb,1,1,noft_occ,1)
      call ddft_sort_occ(norb,noft_occ,ddft_occ,ddft_ind)
      occ_1e_b = ddft_occupations%occ_1e_b
      call ga_zero(occ_1e_b)
      do ii = 1, nel
        jj = ddft_ind(ii)
        call ga_put(occ_1e_b,jj,jj,1,1,one,1)
      enddo
      !
      deallocate(noft_occ)
      deallocate(ddft_occ)
      deallocate(ddft_ind)
      !
      end subroutine ddft_occupations_calculate
!
!-----------------------------------------------------------------------
!
      subroutine ddft_sort_occ(norb,occ,vals,indxs)
      implicit none
      !> The number of orbitals
      integer,       intent(in) :: norb
      !> The actual occupation numbers
      real(kind=dp), intent(in) :: occ(:)
      !> The occupation numbers in decreasing order
      real(kind=dp), intent(out) :: vals(:)
      !> The indeces of the sorted occupation numbers
      integer,       intent(out) :: indxs(:)
      !
      ! Local
      !
      integer :: nvals
      integer :: ii, jj, kk
      real(kind=dp) :: val
      integer :: indx
      !
      vals(1) = occ(1)
      indxs(1) = 1
      nvals = 1
      do while (nvals < norb)
        ii = nvals+1
        if (vals(nvals) > occ(ii)) then
          nvals = nvals + 1
          vals(nvals) = occ(ii)
          indxs(nvals) = ii
        else
          jj = nvals
          do while (jj >= 1 .and. vals(jj) < occ(ii))
            jj = jj - 1
          enddo
          do kk = nvals, jj+1, -1
            vals(kk+1) = vals(kk)
            indxs(kk+1) = indxs(kk)
          enddo
          vals(jj+1) = occ(ii)
          indxs(jj+1) = ii
          nvals = nvals + 1
        endif
      enddo
      end subroutine ddft_sort_occ
!
!-----------------------------------------------------------------------
