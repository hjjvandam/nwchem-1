!-----------------------------------------------------------------------
!
!> \brief Print the job parameters
!>
      subroutine noft_print_parameters(noft_params)
      implicit none
#include "cdft.fh"
#include "errquit.fh"
#include "global.fh"
#include "stdio.fh"
#include "noft_solver_options.fh"
#include "noft_functional_options.fh"
      !> The job parameters
      type(noft_parameter_tp), intent(in) :: noft_params
!
      logical :: oroot
!
      oroot = ga_nodeid().eq.0
      if (oroot) then
        write(luout,'(" NOFT settings")')
        write(luout,'(" =============")')
        write(luout,*)
        write(luout,'(" use symmetry                  : ",$)')
        if (noft_params%symmetry_adapt) then
          write(luout,'("yes")')
        else
          write(luout,'(" no")')
        endif
        write(luout,'(" spin restricted               : ",$)')
        if (noft_params%restricted) then
          write(luout,'("yes")')
        else
          write(luout,'(" no")')
        endif
        write(luout,'(" functional                    : ",$)')
        if (noft_params%functional.eq.same) then
          write(luout,'("bracket same side, and weak correlation")')
        else if (noft_params%functional.eq.conjugate) then
          write(luout,'("bracket conjugate side, and weak correlation")'
     &          )
        else if (noft_params%functional.eq.both) then
          write(luout,'("bracket both same and conjugate sides, and weak
     & correlation")')
        else if (noft_params%functional.eq.weakstrong) then
          write(luout,'("bracket conjugate side, and combined ",$)')
          write(luout,'("weak and strong correlation")')
        else if (noft_params%functional.eq.weakstrong_ii) then
          write(luout,'("bracket conjugate side, and combined ",$)')
          write(luout,'("weak and strong correlation II")')
        else if (noft_params%functional.eq.weakstrong_iii) then
          write(luout,'("bracket conjugate side, and combined ",$)')
          write(luout,'("weak and strong correlation III")')
        else if (noft_params%functional.eq.weakstrong_iv) then
          write(luout,'("bracket conjugate side, and combined ",$)')
          write(luout,'("weak and strong correlation IV")')
        else if (noft_params%functional.eq.weakstrong_v) then
          write(luout,'("bracket conjugate side, and combined ",$)')
          write(luout,'("weak and strong correlation V")')
        else if (noft_params%functional.eq.average) then
          write(luout,'("bracket conjugate side, and combined ",$)')
          write(luout,'("average correlation")')
        else if (noft_params%functional.eq.nocorrelation) then
          write(luout,'("no-correlation functional")')
        else if (noft_params%functional.eq.ddft) then
          write(luout,'("difference density functional (ddft)")')
        else if (noft_params%functional.eq.ddft_ii) then
          write(luout,'("difference density functional II (ddft_ii)")')
        else if (noft_params%functional.eq.dft) then
          write(luout,'("density functional theory (dft)")')
        else if (noft_params%functional.eq.noftf) then
          write(luout,'("natural orbital functional (noft)")')
        else
          write(luout,'(" ERROR: unknown functional")')
          call errquit("unknown functional option",
     &                 noft_params%functional,UERR)
        endif
        write(luout,'(" schlenker function            : ",$)')
        if (noft_params%s_ls.eq.s0_ls) then
          write(luout,'("none")')
        else if (noft_params%s_ls.eq.s1_ls) then
          write(luout,'("s1(x) = x")')
        else if (noft_params%s_ls.eq.s2_ls) then
          write(luout,'("s2(x) = 3 x - 6 x**2 + 4 x**3")')
        else if (noft_params%s_ls.eq.s3_ls) then
          write(luout,'("s3(x) = 15 x**2 - 50 x**3 + 60 x**4 - 24 x**5")
     &')
        else if (noft_params%s_ls.eq.s2s3_ls) then
          write(luout,'("s2(x) = 3 x - 6 x**2 + 4 x**3")')
          write(luout,'("                               : ",$)')
          write(luout,'("s3(x) = 15 x**2 - 50 x**3 + 60 x**4 - 24 x**5")
     &')
          write(luout,'("                               : ",$)')
          write(luout,'("x <= 0.5: s2(x); x > 0.5: s3(x)")')
        else if (noft_params%s_ls.eq.s3s2_ls) then
          write(luout,'("s2(x) = 3 x - 6 x**2 + 4 x**3")')
          write(luout,'("                               : ",$)')
          write(luout,'("s3(x) = 15 x**2 - 50 x**3 + 60 x**4 - 24 x**5")
     &')
          write(luout,'("                               : ",$)')
          write(luout,'("x <= 0.5: s3(x); x > 0.5: s2(x)")')
        else
          write(luout,'(" ERROR: unknown schlenker function")')
          call errquit("unknown schlenker function option",
     &                 noft_params%s_ls,UERR)
        endif
        write(luout,'(" sigma-sigma   prefactor       : ",f12.6)')
     &        noft_params%c_aa
        write(luout,'(" alpha-beta    prefactor       : ",f12.6)')
     &        noft_params%c_ab
        write(luout,'(" Löwdin-Shull  prefactor       : ",f12.6)')
     &        noft_params%c_ls
        write(luout,'(" Löwdin-Shull2 prefactor       : ",f12.6)')
     &        noft_params%c_ols
        write(luout,'(" NOFT          prefactor       : ",f12.6)')
     &        noft_params%c_noft
        write(luout,'(" ddft          prefactor       : ",f12.6)')
     &        noft_params%c_ddft
        write(luout,'(" dft           prefactor       : ",f12.6)')
     &        noft_params%c_dft
        write(luout,'(" sigma-sigma   power           : ",f12.6)')
     &        noft_params%p_aa
        write(luout,'(" alpha-beta    power           : ",f12.6)')
     &        noft_params%p_ab
        write(luout,'(" Löwdin-Shull  power           : ",f12.6)')
     &        noft_params%p_ls
        write(luout,'(" Löwdin-Shull2 power           : ",f12.6)')
     &        noft_params%p_ols
        write(luout,'(" NOFT          power           : ",f12.6)')
     &        noft_params%p_noft
        write(luout,'(" NOFT          exponent        : ",f12.6)')
     &        noft_params%p_enoft
        write(luout,'(" ddft          power           : ",f12.6)')
     &        noft_params%p_ddft
        write(luout,'(" ddft_d        power           : ",f12.6)')
     &        p_ddft_d
        write(luout,'(" solver                        : ",$)')
        if (noft_params%solver.eq.monte_carlo) then
          write(luout,'(" Monte Carlo")')
        else if (noft_params%solver.eq.pair_rotation) then
          write(luout,'(" Pair rotations")')
        else if (noft_params%solver.eq.gradient_descent) then
          write(luout,'(" Gradient descent")')
        else
          write(luout,'(" ERROR: unknown solver")')
          call errquit("unknown solver option",noft_params%solver,UERR)
        endif
        write(luout,'(" maximum number of iterations  : ",$)')
        write(luout,'(i6)')noft_params%maxiter
        write(luout,'(" number of open shells         : ",$)')
        write(luout,'(i6)')noft_params%no_open
        write(luout,'(" number of core orbitals       : ",$)')
        write(luout,'(i6)')noft_params%ncore_a
        write(luout,'(" number of virtual orbitals    : ",$)')
        write(luout,'(i6)')noft_params%nvirtual_a
        if (noft_params%functional.eq.ddft.or.
     &      noft_params%functional.eq.ddft_ii.or.
     &      noft_params%functional.eq.dft) then
          call noft_print_xc()
        endif
        write(luout,*)
      endif
!
      end subroutine noft_print_parameters
!
!-----------------------------------------------------------------------
